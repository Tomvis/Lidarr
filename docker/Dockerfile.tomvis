# Tomvis/Lidarr image: hotio's nightly of the same version with this fork's backend and UI overlaid.
# Build from `git archive enhanced` on .120 (MUSIC-62). Keep LIDARRVERSION equal to the merged
# upstream tag: plugins (Tidal, Tubifarry) bind to that assembly version.
ARG LIDARRVERSION=3.1.6.5078

FROM mcr.microsoft.com/dotnet/sdk:8.0.421 AS build
ARG LIDARRVERSION
WORKDIR /src
COPY . .
# HW-158: NuGet packages in a BuildKit cache mount -- COPY . . above invalidates every layer after it,
# so without this each build restored every package from scratch. The context can hold forksync's
# check build (_temp/obj assets): `dotnet clean` then fails NETSDK1064 against a package folder that
# exists but lacks those packages, so drop it first.
RUN --mount=type=cache,target=/root/.nuget/packages \
    rm -rf _temp _output _tests \
    && LIDARRVERSION=$LIDARRVERSION BUILD_SOURCEBRANCHNAME=nightly NuGetAudit=false \
        ./build.sh --backend -r linux-musl-x64 -f net8.0 \
    && cd _output/net8.0/linux-musl-x64/publish \
    && rm -f Lidarr.Windows.* ServiceInstall.* ServiceUninstall.*

# Node as upstream CI (azure-pipelines nodeVersion 20.X)
FROM node:20.18.1-alpine AS ui
WORKDIR /src
COPY package.json yarn.lock .yarnrc ./
RUN yarn install --frozen-lockfile --network-timeout 120000
COPY . .
RUN yarn run build --env production

FROM ghcr.io/hotio/lidarr:nightly-${LIDARRVERSION}
ARG FORK_SHA=unknown
RUN rm -rf /app/bin/UI
COPY --from=build /src/_output/net8.0/linux-musl-x64/publish/ /app/bin/
COPY --from=ui /src/_output/UI/ /app/bin/UI/
RUN apk add --no-cache ffmpeg \
    && sed -i "s/^PackageVersion=.*/PackageVersion=tomvis-${FORK_SHA}/" /app/package_info
